<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study2.practice.category.mapper.CategoryMapper">

  <!-- ORDER BY 없으면 DB가 순서를 보장 안 해서, 카테고리 목록(드롭다운 등)이 매번 다른
       순서로 보일 수 있음. id 순으로 고정 -->
  <select id="findAll" resultType="com.study2.practice.category.entity.Category">
    SELECT id, name
    FROM category
    ORDER BY id
  </select>

  <select id="findById" resultType="com.study2.practice.category.entity.Category">
    SELECT id, name
    FROM category
    WHERE id = #{id}
  </select>

</mapper>